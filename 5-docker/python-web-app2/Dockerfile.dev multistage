#Exemple of a multi-stage Dockerfile for a Python web application
#decription: This Dockerfile uses multi-stage builds to create a lightweight production image for a Python web application. The first stage installs dependencies and builds the application, while the second stage creates a minimal image for running the application.
#meanwhile, the first stage is used to install dependencies and build the application, while the second stage creates a minimal image for running the application. This approach helps to reduce the size of the final image and improve security by excluding unnecessary build tools and files.

#etape 1: Build the application
FROM python:3.11-slim as builder

WORKDIR /app

COPY requirements.txt /app/
RUN pip3 install --break-system-packages --no-cache-dir -r requirements.txt

COPY . .

#etape 2: Production :Run the application
FROM python:3.11-slim
COPY --from=builder /app/app.py .
WORKDIR /app
EXPOSE 8000
ENTRYPOINT ["python3", "manage.py"]
CMD ["runserver", "0.0.0.0:8000"]